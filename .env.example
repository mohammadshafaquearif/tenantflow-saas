NODE_ENV=development
PORT=4000

# ─── Local PostgreSQL (docker compose) ───
DATABASE_URL=postgresql://tenantflow:tenantflow_secret@localhost:5432/tenantflow

# ─── Vercel Postgres / Neon (auto-injected on Vercel — do NOT set manually locally) ───
# POSTGRES_URL=              # pooled — runtime queries (serverless)
# POSTGRES_URL_NON_POOLING=  # direct — migrations / CREATE SCHEMA
# POSTGRES_PRISMA_URL=       # fallback pooled URL

# Required on Vercel production — generate: openssl rand -base64 48
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_EXPIRES_IN=8h

# Comma-separated origins for CORS (Vercel URL is added automatically)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
